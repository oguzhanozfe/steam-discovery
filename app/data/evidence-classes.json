      "label": "Observed",
      "description": "A public record or metric (Steam reviews, SteamDB, store page) checked on a stated date."
    },
    "estimate": {
      "label": "Estimate",
      "description": "A third-party model or proxy (owner estimates, follower multipliers, revenue models). Not sales."
    },
    "analysis": {
      "label": "Analysis",
      "description": "An analyst or practitioner interpretation, survey or cohort comparison, or a claim that mixes sources. Not a measured effect."
    },
    "editorial": {
